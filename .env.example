# ==============================================================================
# ACADEMIC PLATFORM — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to `.env` or set these environment variables in your deployment
# pipeline (e.g. Render, Railway, Fly.io, Vercel, Heroku, Docker).
#
# IMPORTANT SECURITY REMINDER:
# - NEVER commit `.env` or any production secrets to version control.
# - NEVER prefix server secrets (Paystack Secret Key, Webhook Secret, Firebase Service
#   Account) with `VITE_`. Any variable starting with `VITE_` will be bundled into
#   client-side JavaScript and exposed to browser end-users.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PAYSTACK PAYMENT INTEGRATION
# ------------------------------------------------------------------------------
# Paystack Secret Key — SERVER-SIDE ONLY (Used for /transaction/initialize and /transaction/verify)
# Format: sk_test_... (sandbox) or sk_live_... (production)
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Paystack Public Key — Safe for frontend bundling (Used by Paystack Inline JS)
# Format: pk_test_... (sandbox) or pk_live_... (production)
VITE_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Paystack Webhook Signing Secret — SERVER-SIDE ONLY
# Used to verify the HMAC SHA-512 signature on x-paystack-signature headers.
# Defaults to PAYSTACK_SECRET_KEY if not explicitly specified.
PAYSTACK_WEBHOOK_SECRET=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Paystack Base API URL (defaults to https://api.paystack.co)
PAYSTACK_BASE_URL=https://api.paystack.co

# ------------------------------------------------------------------------------
# 2. FIREBASE AUTHENTICATION & CLIENT SDK
# ------------------------------------------------------------------------------
# Client-side Firebase configuration for user identity and token issuance
VITE_FIREBASE_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_FIREBASE_AUTH_DOMAIN=academic-platform-prod.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=academic-platform-prod
VITE_FIREBASE_STORAGE_BUCKET=academic-platform-prod.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890abcdef

# Firebase Admin SDK Credentials (Optional for local dev, recommended in production)
# Can be the file path to serviceAccountKey.json or a base64 encoded string
# FIREBASE_SERVICE_ACCOUNT_KEY=/etc/secrets/firebase-service-account.json

# ------------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION (POSTGRESQL)
# ------------------------------------------------------------------------------
# The platform utilizes PostgreSQL with full ACID compliance for billing, entitlements,
# usage limits, and user academic records.
#
# If DATABASE_URL is unset, the system defaults to embedded persistent PostgreSQL
# via @electric-sql/pglite storing data in `./data/academic-platform.db`.
# DATABASE_URL=postgresql://postgres:password@localhost:5432/academic_platform

# ------------------------------------------------------------------------------
# 4. SERVER & RUNTIME ENVIRONMENT
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=5173

# ------------------------------------------------------------------------------
# 5. ZEGOCLOUD REALTIME VIDEO & AUDIO
# ------------------------------------------------------------------------------
# ZEGOCLOUD App ID & Server Secret for WebRTC live 1-on-1 tutoring sessions
VITE_ZEGOCLOUD_APP_ID=1234567890
ZEGOCLOUD_SERVER_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
