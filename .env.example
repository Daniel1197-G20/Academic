# ── Application Environment & Server ───────────────────────────────────────────
NODE_ENV=development
PORT=5173
APP_SECRET=your_long_random_app_secret_here

# ── Supabase Configuration (Canonical Identity & Database) ────────────────────
# Public/Browser credentials
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_jwt_key_here

# Server credentials (server-only)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_jwt_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here
SUPABASE_JWT_SECRET=your_supabase_jwt_signing_secret_here

# ── GetStream Communication Infrastructure (Real-Time Chat & Video) ───────────
# Public client API key (safe for browser)
VITE_STREAM_API_KEY=your_stream_api_key_here
STREAM_API_KEY=your_stream_api_key_here

# Server API Secret (server-only — NEVER expose to frontend or git)
STREAM_API_SECRET=your_stream_api_secret_here

# ── ZEGOCLOUD (Legacy Real-Time RTC — Transitional) ───────────────────────────
VITE_ZEGOCLOUD_APP_ID=1234567890
ZEGOCLOUD_APP_ID=1234567890
ZEGOCLOUD_SERVER_SECRET=your_zegocloud_server_secret_here

# ── Paystack Payments & Subscriptions ─────────────────────────────────────────
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_WEBHOOK_SECRET=your_paystack_webhook_signing_secret_here
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_LIVE_HTTP=false

# ── AI Tutor (xAI Grok) ───────────────────────────────────────────────────────
GROK_API_KEY=your_xai_grok_api_key_here
GROK_API_URL=https://api.x.ai/v1/chat/completions
GROK_MODEL=grok-2-latest

# ── Firebase Auth (Legacy Transitional Bridge) ────────────────────────────────
VITE_FIREBASE_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_FIREBASE_AUTH_DOMAIN=academic-platform-prod.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=academic-platform-prod
VITE_FIREBASE_STORAGE_BUCKET=academic-platform-prod.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890abcdef

# ── Database Storage (Optional Local Override) ────────────────────────────────
# DB_PATH=./data/academic-platform.db
